# Optional. Treat this as a bearer secret and remove it after the private
# browser profile has been authenticated.
KAGI_SESSION_LINK=

# Public link used by the disclosure in reviewed replies.
HOUNDO_PROJECT_URL=https://github.com/Leftium/houndo

